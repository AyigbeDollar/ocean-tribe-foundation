# Copy this file to .env and fill in your values for local development.
# In production (Vercel), add these as Environment Variables in the project settings.

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Paystack public key for donations (safe to expose client-side).
# Use pk_test_... while testing and pk_live_... in production.
VITE_PAYSTACK_PUBLIC_KEY="pk_live_..."

# Optional: OpenTelemetry traces to Honeycomb. Leave blank to disable (the
# tracing SDK is then not even bundled). Use an INGEST key limited to
# "Send events" - it is visible in the browser.
VITE_HONEYCOMB_API_KEY=""
# EU accounts: https://api.eu1.honeycomb.io
# VITE_HONEYCOMB_ENDPOINT="https://api.honeycomb.io"
