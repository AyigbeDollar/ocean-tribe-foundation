{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [640, 1200, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000,
    "localPatterns": [{ "pathname": "^/img/(photos|og)/.*$" }]
  },
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/jobs", "destination": "/glmis", "permanent": true },
    { "source": "/news", "destination": "/blog", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true }
  ],
  "headers": [
    { "source": "/js/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
